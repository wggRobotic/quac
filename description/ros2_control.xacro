<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <ros2_control name="wheel_ddsm115_control" type="system">
        <hardware>
            <plugin>quac_hardware/DDSM115</plugin>
            <param name="port">/dev/ttyUSB1</param>
            <param name="act">1</param>
            <param name="feedback">true</param>
        </hardware>

        <joint name="wheel_front_left_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <param name="id">4</param>
            <param name="scalar">1</param>
        </joint>

        <joint name="wheel_front_right_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <param name="id">1</param>
            <param name="scalar">-1</param>
        </joint>

        <joint name="wheel_rear_left_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <param name="id">3</param>
            <param name="scalar">1</param>
        </joint>

        <joint name="wheel_rear_right_joint">
            <command_interface name="velocity"/>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <param name="id">2</param>
            <param name="scalar">-1</param>
        </joint>

    </ros2_control>

    <ros2_control name="arm_waveshare_servos_control" type="system">
        <hardware>
            <plugin>quac_hardware/WaveshareServos</plugin>
            <param name="crawler_arm_param_hw_start_duration_sec">0</param>
            <param name="crawler_arm_hw_stop_duration_sec">3.0</param>
            <param name="crawler_arm_hw_slowdown">100</param>
        </hardware>
    
        <joint name="arm_servo_0_joint">
            <param name="id">5</param>
            <param name="type">pos</param>
            <param name="offset">1.570796</param>
        
            <command_interface name="position">
                <param name="min">-1.570796</param>
                <param name="max">1.570796</param>
            </command_interface>
            <command_interface name="velocity">
                <param name="min">-9.2</param>
                <param name="max">9.2</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="temperature"/>
        </joint>

        <joint name="arm_servo_1_joint">
            <param name="id">6</param>
            <param name="type">pos</param>
            <param name="inverted">true</param>
            <param name="offset">1.8</param>
            <command_interface name="position">
                <param name="min">-0.8</param>
                <param name="max">1.570796</param>
            </command_interface>
            <command_interface name="velocity">
                <param name="min">-9.2</param>
                <param name="max">9.2</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="temperature"/>
        </joint>

        <joint name="gripper_servo_joint">
            <param name="id">1</param>
            <param name="type">pos</param>
            <param name="inverted">true</param> 
            <param name="offset">1.75</param>
            <command_interface name="position">
                <param name="min">0</param>
                <param name="max">1.7</param>
            </command_interface>
            <command_interface name="velocity">
                <param name="min">-9.2</param>
                <param name="max">9.2</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="torque"/>
            <state_interface name="temperature"/>
        </joint>

    </ros2_control> 

    
</robot>
