<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <ros2_control name="quac_hardware" type="system">
    <hardware>
        <plugin>quac_hardware/DiffDriveDDSM115</plugin>
        <param name="port">/dev/ttyACM0</param>
        <param name="encoder_resolution">4096</param>
        <param name="act">6</param>
        <param name="use_esp32">false</param>
    </hardware>

    <joint name="wheel_front_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">1</param>
        <param name="scalar">1</param>
    </joint>

    <joint name="wheel_front_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">2</param>
        <param name="scalar">-1</param>
    </joint>

    <joint name="wheel_rear_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">3</param>
        <param name="scalar">1</param>
    </joint>

    <joint name="wheel_rear_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <param name="id">4</param>
        <param name="scalar">-1</param>
    </joint>
</ros2_control>
    
</robot>
