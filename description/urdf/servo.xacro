<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="servo_x" value="0.0455"/>
    <xacro:property name="servo_y" value="0.025"/>
    <xacro:property name="servo_z" value="0.035"/>

    <xacro:macro name="servo_macro" params="name">
        <link name="${name}">
            <visual>
                <origin xyz="-0.011375 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${servo_x} ${servo_y} ${servo_z}" />
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin xyz="-0.011375 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${servo_x} ${servo_y} ${servo_z}" />
                </geometry>
            </collision>
            <xacro:inertial_box mass="0.1" x="${servo_x}" y="${servo_y}" z="${servo_z}">
                <origin xyz="-0.011375 0 0" rpy="0 0 0" />
            </xacro:inertial_box>
        </link>

        <link name="${name}_axis">
            <visual>
                <geometry>
                    <cylinder radius="0.002" length="0.08" />
                </geometry>
                <material name="red" />
            </visual>
            <xacro:inertial_cylinder mass="0.1" length="0.08" radius="0.002">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

    </xacro:macro>

    <xacro:macro name="servo" params="name">

        <xacro:servo_macro name="${name}"/>

        <joint name="${name}_joint" type="revolute">
            <parent link="${name}" />
            <child link="${name}_axis" />
            <axis xyz="0 0 -1" />
            <limit lower="-1.57" upper="1.57" effort="1" velocity="1" />
        </joint>

    </xacro:macro>

    <xacro:macro name="servo_flipped" params="name">
        
        <joint name="${name}_joint" type="revolute">
            <parent link="${name}_axis" />
            <child link="${name}" />
            <axis xyz="0 0 -1" />
            <limit lower="-1.57" upper="1.57" effort="1" velocity="1" />
        </joint>

        <xacro:servo_macro name="${name}"/>

    </xacro:macro>


</robot>