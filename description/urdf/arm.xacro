<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="plate_x" value="0.110" />
    <xacro:property name="plate_y" value="0.03" />
    <xacro:property name="plate_z" value="0.002" />    

    <xacro:macro name="plate" params="plate_name">
        <link name="${plate_name}">
            <visual>
                <geometry>
                    <box size="${plate_x} ${plate_y} ${plate_z}" />
                </geometry>
                <material name="orange" />
            </visual>
            <collision>
                <geometry>
                    <box size="${plate_x} ${plate_y} ${plate_z}" />
                </geometry>
            </collision>
            <xacro:inertial_box mass="0.1" x="${plate_x}" y="${plate_y}" z="${plate_z}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_box>
        </link>
    </xacro:macro>

    <!-- Materials -->
    <material name="black_tr">
        <color rgba="0.05 0.05 0.05 0.5" />
    </material>
    <material name="orange">
        <color rgba="1.0 0.4 0.0 1.0" />
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1.0" />
    </material>
    <material name="red">
        <color rgba="0.5 0.00 0.00 1.0" />
    </material>

    <!-- Model -->

    <joint name="arm_base_joint" type="fixed">
        <parent link="chassis" />
        <child link="arm_servo_0_axis" />
        <origin xyz="0.0 0.135 0.04" rpy="0 ${pi/2} 0" />
    </joint>

    <xacro:servo_flipped name="arm_servo_0"/>

    <joint name="plate_0_joint" type="fixed">
        <parent link="arm_servo_0" />
        <child link="plate_0" />
        <origin xyz="-0.058875 0.0 0.0185" rpy="0 0 0" />
    </joint>

    <joint name="plate_1_joint" type="fixed">
        <parent link="arm_servo_0" />
        <child link="plate_1" />
        <origin xyz="-0.058875 0.0 -0.0185" rpy="0 0 0" />
    </joint>

    <xacro:plate plate_name="plate_0"/>
    <xacro:plate plate_name="plate_1"/>

    <joint name="arm_seg_0_joint" type="fixed">
        <parent link="arm_servo_0" />
        <child link="arm_servo_1" />
        <origin xyz="-0.101375 0.03 0.0" rpy="0 0 ${pi/2}" />
    </joint>

    <xacro:servo name="arm_servo_1"/>

    <joint name="plate_2_joint" type="fixed">
        <parent link="arm_servo_1_axis" />
        <child link="plate_2" />
        <origin xyz="0.0425 0 0.0185" rpy="0 0 0" />
    </joint>

    <joint name="plate_3_joint" type="fixed">
        <parent link="arm_servo_1_axis" />
        <child link="plate_3" />
        <origin xyz="0.0425 0 -0.0185" rpy="0 0 0" />
    </joint>

    <xacro:plate plate_name="plate_2"/>
    <xacro:plate plate_name="plate_3"/>

    <joint name="arm_segment_1_joint" type="fixed">
        <parent link="arm_servo_1_axis" />
        <child link="gripper_servo" />
        <origin xyz="0.1 0.0 0.0" rpy="${-pi/2} 0 0" />
    </joint>

    <xacro:servo name="gripper_servo"/>

    <joint name="gripper_gear_joint" type="fixed">
        <parent link="gripper_servo_axis" />
        <child link="gripper_gear" />
        <origin xyz="0.0 0.0 0.03" rpy="0 0 0" />
    </joint>

    <link name="gripper_gear">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.02" />
            </geometry>
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.02" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

</robot>