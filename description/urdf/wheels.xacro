<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="wheel" params="name xyz">
        <joint name="${name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <parent link="chassis"/>
            <child link="${name}"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="0.06" length="0.04" />
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="0.06" length="0.04" />
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="0.1" radius="0.06" length="0.04">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>

            <gazebo>
                <mu1>0.2</mu1>       <!-- lateral friction -->
                <mu2>0.8</mu2>       <!-- longitudinal friction -->
                <fdir1>1 0 0</fdir1> <!-- wheel forward direction -->
                <slip1>0.1</slip1>  <!-- longitudinal slip tolerance -->
                <slip2>0.5</slip2>  <!-- lateral slip tolerance -->
                <turning_surface>false</turning_surface> <!-- optional -->
            </gazebo>

        </link>

        <gazebo reference="${name}">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <!-- Four wheels -->
    
    <xacro:wheel name="wheel_front_left" xyz="0.1075 0.1005 -0.03705" />
    <xacro:wheel name="wheel_front_right" xyz="0.1075 -0.1005 -0.03705" />
    <xacro:wheel name="wheel_rear_left" xyz="-0.1075 0.1005 -0.03705" />
    <xacro:wheel name="wheel_rear_right" xyz="-0.1075 -0.1005 -0.03705" />
    
</robot>