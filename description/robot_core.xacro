<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="inertial_cylinder" params="mass length radius *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}" />
            <inertia ixx="${(1/12) * mass * (3*radius*radius + length*length)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (3*radius*radius + length*length)}" iyz="0.0"
                    izz="${(1/2) * mass * (radius*radius)}" />
        </inertial>
    </xacro:macro>

    <xacro:property name="mesh_scale" value="0.001"/>

    <material name="chassis_material">
        <color rgba="1.0 1.0 1.0 1.0" />
    </material>

    <material name="wheel_material">
        <color rgba="0.6 0.6 0.6 1.0" />
    </material>

    <link name="base_link"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint"/>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0.0" rpy="0 0 ${-pi/2}"/>
    </joint>

    <link name="chassis">
        <inertial>
            <origin xyz="-7.066717348492194e-05 3.485618129802738e-05 0.00889428874586655" rpy="0 0 0"/>
            <mass value="2.985747783671821"/>
            <inertia ixx="0.025172" iyy="0.005971" izz="0.030362" ixy="-6e-06" iyz="2e-06" ixz="-2e-06"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
            <mesh filename="package://usb_ros2_state/meshes/base_link.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="chassis_material"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
            <mesh filename="package://usb_ros2_state/meshes/base_link.stl" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
        </collision>
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/White</material>
        <mu1>0.2</mu1>
        <mu2>0.2</mu2>
        <gravity>true</gravity>
    </gazebo>

    
    <xacro:macro name="wheel_visual" params="name joint_origin_xyz">
        <joint name="${name}_joint" type="fixed">
            <origin xyz="${joint_origin_xyz}" rpy="0 0 0"/>
            <parent link="chassis"/>
            <child link="${name}"/>
            <axis xyz="-1.0 0.0 0.0"/>
        </joint>

        <link name="${name}">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="1.0"/>
                <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="0.0" ixz="0.0"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
                <material name="wheel_material"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>
        </link>


        <gazebo reference="${name}">
            <material>Gazebo/Black</material>
            <mu1 value="0.001"/>
            <mu2 value="0.001"/>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="wheel_real" params="name joint_origin_xyz">
        <joint name="${name}_joint" type="continuous">
            <origin xyz="${joint_origin_xyz}" rpy="0 0 0"/>
            <parent link="chassis"/>
            <child link="${name}"/>
            <axis xyz="-1.0 0.0 0.0"/>
        </joint>

        <link name="${name}">
            <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
                <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
            </xacro:inertial_cylinder>
            <collision>
                <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>
        </link>

        <transmission name="${name}_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${name}_joint">
                <hardware_interface>velocity</hardware_interface>
            </joint>
            <actuator name="${name}_motor">
                <hardware_interface>velocity</hardware_interface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>
    </xacro:macro>

    <xacro:macro name="wheel" params="name joint_origin_xyz link_xyz mesh">
        <joint name="${name}_joint" type="continuous">
            <origin xyz="${joint_origin_xyz}" rpy="0 0 0"/>
            <parent link="chassis"/>
            <child link="${name}"/>
            <axis xyz="-1.0 0.0 0.0"/>
        </joint>

        <link name="${name}">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="1.0708903957924194"/>
                <inertia ixx="0.001339" iyy="0.000897" izz="0.000897" ixy="0.0" iyz="0.0" ixz="0.0"/>
            </inertial>
            <visual>
                <origin xyz="${link_xyz}" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="${mesh}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
                </geometry>
                <material name="wheel_material"/>
            </visual>
            <collision>
                <origin xyz="${link_xyz}" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="${mesh}" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
                </geometry>
            </collision>
        </link>

        <transmission name="${name}_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${name}_joint">
                <hardware_interface>velocity</hardware_interface>
            </joint>
            <actuator name="${name}_motor">
                <hardware_interface>velocity</hardware_interface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <gazebo reference="${name}">
            <material>Gazebo/Black</material>
        </gazebo>
    </xacro:macro>

    <!-- Four wheels -->

    
    <xacro:wheel 
        name="wheel_rear_right"  
        joint_origin_xyz="0.105 -0.104 -0.0183"  
        link_xyz="-0.105 0.104 0.0183" 
        mesh="package://usb_ros2_state/meshes/wheel.stl"
        />

    <xacro:wheel 
        name="wheel_front_right" 
        joint_origin_xyz="0.105 0.104 -0.0183" 
        link_xyz="-0.105 -0.104 0.0183" 
        mesh="package://usb_ros2_state/meshes/wheel_2.stl"
        />
    <xacro:wheel 
        name="wheel_front_left"   
        joint_origin_xyz="-0.105 0.104 -0.0183" 
        link_xyz="0.105 -0.104 0.0183" 
        mesh="package://usb_ros2_state/meshes/wheel_3.stl"
        />
    <xacro:wheel 
        name="wheel_rear_left"  
        joint_origin_xyz="-0.105 -0.104 -0.0183" 
        link_xyz="0.105 0.104 0.0183" 
        mesh="package://usb_ros2_state/meshes/wheel_4.stl"
        />
    <!-- 

    <xacro:wheel_visual 
        name="wheel_rear_right"  
        joint_origin_xyz="0.105 -0.104 -0.0183"  
        />

    <xacro:wheel_visual 
        name="wheel_front_right" 
        joint_origin_xyz="0.105 0.104 -0.0183" 
        />
    <xacro:wheel_visual 
        name="wheel_front_left"   
        joint_origin_xyz="-0.105 0.104 -0.0183" 
        />
    <xacro:wheel_visual 
        name="wheel_rear_left"  
        joint_origin_xyz="-0.105 -0.104 -0.0183" 
        />

    <xacro:wheel_real
        name="wheel_left"   
        joint_origin_xyz="-0.105 0.0 -0.0183" 
        />
    <xacro:wheel_real 
        name="wheel_right"  
        joint_origin_xyz="0.105 0.0 -0.0183" 
        />
    -->
    

</robot>
