<sdf version='1.10' xmlns:xacro="http://www.ros.org/wiki/xacro">
  <world name='empty'>
    <physics name='1ßms' type='ignored'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <gravity>0 0 -9.8000000000000007</gravity>
    <magnetic_field>5.5644999999999998e-06 2.2875799999999999e-05 -4.2388400000000002e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.400000006 0.400000006 0.400000006 1</ambient>
      <background>0.699999988 0.699999988 0.699999988 1</background>
      <shadows>true</shadows>
    </scene>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.800000012 0.800000012 0.800000012 1</ambient>
            <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
            <specular>0.800000012 0.800000012 0.800000012 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0 0 0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 0 0</pose>
      <self_collide>false</self_collide>
    </model>

    <xacro:macro name="hurdle_box" params="name x y size">
      <model name='${name}'>
        <pose>${x} ${y} 0.049999999990199806 6.2287739151293738e-22 9.3279666454713669e-22 -3.6315533669320137e-22</pose>
        <link name='${name}_link'>
          <inertial>
            <inertia>
              <ixx>0.16666</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.16666</iyy>
              <iyz>0</iyz>
              <izz>0.16666</izz>
            </inertia>
            <mass>1</mass>
            <pose>0 0 0 0 0 0</pose>
          </inertial>
          <collision name='${name}_collision'>
            <geometry>
              <box>
                <size>${size} ${size} ${size}</size>
              </box>
            </geometry>
            <surface>
              <friction>
                <ode/>
              </friction>
              <bounce/>
              <contact/>
            </surface>
          </collision>
          <visual name='${name}_visual'>
            <geometry>
              <box>
                <size>${size} ${size} ${size}</size>
              </box>
            </geometry>
            <material>
              <ambient>0.300000012 0.300000012 0.300000012 1</ambient>
              <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
              <specular>1 1 1 1</specular>
            </material>
          </visual>
          <pose>0 0 0 0 0 0</pose>
          <enable_wind>false</enable_wind>
        </link>
        <static>false</static>
        <self_collide>false</self_collide>
      </model>
    </xacro:macro>

    <xacro:macro name="hurdle_cylinder" params="name">
      <model name='${name}'>
        <pose>0.21278173043812618 0.37029515542140965 0.049999942638036005 2.4289046005190011e-20 1.5754678275059134e-20 -9.0169543863959e-21</pose>
        <link name='${name}_link'>
          <inertial>
            <inertia>
              <ixx>0.14580000000000001</ixx>
              <ixy>0</ixy>
              <ixz>0</ixz>
              <iyy>0.14580000000000001</iyy>
              <iyz>0</iyz>
              <izz>0.125</izz>
            </inertia>
            <mass>1</mass>
            <pose>0 0 0 0 0 0</pose>
          </inertial>
          <collision name='${name}_collision'>
            <geometry>
              <cylinder>
                <radius>0.1</radius>
                <length>0.2</length>
              </cylinder>
            </geometry>
            <surface>
              <friction>
                <ode/>
              </friction>
              <bounce/>
              <contact/>
            </surface>
          </collision>
          <visual name='${name}_visual'>
            <geometry>
              <cylinder>
                <radius>0.1</radius>
                <length>0.2</length>
              </cylinder>
            </geometry>
            <material>
              <ambient>0.300000012 0.300000012 0.300000012 1</ambient>
              <diffuse>0.699999988 0.699999988 0.699999988 1</diffuse>
              <specular>1 1 1 1</specular>
            </material>
          </visual>
          <pose>0 0 0 0 0 0</pose>
          <enable_wind>false</enable_wind>
        </link>
        <static>false</static>
        <self_collide>false</self_collide>
      </model>
    </xacro:macro>

    <xacro:hurdle_box name="box1" x="0.3" y="0.5" size="0.2" />
    <xacro:hurdle_box name="box2" x="0.6" y="-0.8" size="0.5" />
    <xacro:hurdle_box name="box3" x="-2" y="-1.3" size="0.8" />
    <xacro:hurdle_box name="box4" x="1.2" y="1.8" size="0.4" />
    <xacro:hurdle_box name="box5" x="0.9" y="-0.5" size="0.2" />
    <xacro:hurdle_box name="box6" x="-0.6" y="2.1" size="0.5" />
    <xacro:hurdle_box name="box7" x="3" y="-0.4" size="0.6" />

    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.10000000000000001 -0.90000000000000002</direction>
      <diffuse>0.800000012 0.800000012 0.800000012 1</diffuse>
      <specular>0.200000003 0.200000003 0.200000003 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>