<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="quac_robot">

    <xacro:property name="mesh_scale" value="0.001"/>

    <xacro:include filename="urdf/inertial_macros.xacro" />
    <xacro:include filename="urdf/servo.xacro" />

    <xacro:include filename="urdf/chassis.xacro" />
    <xacro:include filename="urdf/wheels.xacro" />
    <xacro:include filename="urdf/arm.xacro" />

    <xacro:unless value="$(arg sim_mode)">
        <xacro:include filename="ros2_control.xacro" />
    </xacro:unless>

    <xacro:if value="$(arg sim_mode)">
        <xacro:include filename="gazebo.xacro" />
    </xacro:if>

    <link name="base_link"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint"/>

</robot>