<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="arm_servo_0_joint" type="continuous">
        <parent link="chassis"/>
        <child link="arm_segment_1"/>
        <origin xyz="0.13 0 0.04475" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <link name="arm_segment_1">
        <xacro:inertial_box mass="0.1" x="0.10" y="0.04" z="0.04">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://quac/meshes/version_6/arm_segment_1.glb" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="chassis_material"/>
        </visual>
    </link>

    <joint name="arm_servo_1_joint" type="continuous">
        <parent link="arm_segment_1"/>
        <child link="arm_segment_2"/>
        <origin xyz="-0.1025 0.0287 0" rpy="0 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <link name="arm_segment_2">
        <xacro:inertial_box mass="0.1" x="0.10" y="0.04" z="0.04">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://quac/meshes/version_6/arm_segment_2.glb" scale="${mesh_scale} ${mesh_scale} ${mesh_scale}"/>
            </geometry>
            <material name="chassis_material"/>
        </visual>
    </link>

    <joint name="gripper_servo_joint" type="continuous">
        <parent link="arm_segment_2" />
        <child link="gripper_gear" />
        <origin xyz="0.05 0.04 0" rpy="${-pi/2} 0 0"/>
        <axis xyz="0 0 1" />
    </joint>

    <link name="gripper_gear">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.02" />
            </geometry>
            <material name="gripper_material" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.02" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.02" radius="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <xacro:sensor_d435 parent="arm_segment_2" name="camera_front" use_nominal_extrinsics="true">
        <origin xyz="0.095 0.016 0" rpy="${-pi/2} 0 0"/>
    </xacro:sensor_d435>

</robot>