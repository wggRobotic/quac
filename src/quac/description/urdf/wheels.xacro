<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="wheel" params="name xyz">
        <joint name="${name}_joint" type="continuous">
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <parent link="chassis"/>
            <child link="${name}"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>

        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="0.06" length="0.04" />
                </geometry>
                <material name="black" />
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="0.06" length="0.04" />
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>       <!-- Static friction -->
                            <mu2>1.0</mu2>     <!-- Dynamic friction -->
                        </ode>
                    </friction>
                </surface>
            </collision>
            <xacro:inertial_cylinder mass="0.1" radius="0.06" length="0.04">
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            </xacro:inertial_cylinder>

        </link>

    </xacro:macro>

    <!-- Four wheels -->
    
    <xacro:wheel name="wheel_front_left" xyz="0.1075 0.1005 -0.03705" />
    <xacro:wheel name="wheel_front_right" xyz="0.1075 -0.1005 -0.03705" />
    <xacro:wheel name="wheel_rear_left" xyz="-0.1075 0.1005 -0.03705" />
    <xacro:wheel name="wheel_rear_right" xyz="-0.1075 -0.1005 -0.03705" />
    
</robot>